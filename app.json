{
  "expo": {
    "name": "Unoscil",
    "slug": "unoscil",
    "scheme": "unoscil",
    "version": "2.4.1",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "buildNumber": "204",
      "supportsTablet": true,
      "appleTeamId": "8XG39X5CL8",
      "bundleIdentifier": "app.unoscil.Unoscil",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.app.unoscil.Unoscil",
          "group.app.unoscil.ios"
        ]
      }
    },
    "android": {
      "versionCode": 204,
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-bg.png",
        "monochromeImage": "./assets/adaptive-icon-mono.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.unoscil.android",
      "permissions": [
        "android.permission.REQUEST_INSTALL_PACKAGES",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/build/withNativeLogger.js",
      "./plugins/build/withLanInsecureTls.js",
      "./plugins/build/withIosSettingsBundle.js",
      "./plugins/build/withIosOrientation.js",
      "./plugins/build/withAndroidOrientation.js",
      "./plugins/build/withNetworkSecurityConfig.js",
      "./plugins/build/withQuickSettingsTileManifest.js",
      "./plugins/build/withProcessTextManifest.js",
      "./plugins/build/withQuickActionActivity.js",
      "./plugins/build/withServiceRestartActivity.js",
      "./plugins/build/withAndroidNativeCode.js",
      "./plugins/build/withClipboardOverlayPermission.js",
      "./plugins/build/withNativeUtilPermission.js",
      "./plugins/build/withForegroundService.js",
      "./plugins/build/withDarkSplashScreen.js",
      "./plugins/build/withAbiSplits.js",
      "./plugins/build/withReleaseSigning.js",
      "./plugins/build/withGradleBuildTuning.js",
      "./plugins/build/withUnifiedEngineRelease.js",
      "./plugins/build/withAndroidBuildVersionName.js",
      "./plugins/build/withPostHogAnalytics.js",
      "./plugins/build/withExtensionP2PKeychainGroup.js",
      "./plugins/build/withXcode27SceneLifecycle.js",
      "./plugins/build/withXcode27DeploymentTargets.js",
      "@bacons/apple-targets",
      "./plugins/build/withLocalNotificationsOnly.js",
      "expo-notifications",
      "expo-secure-store",
      [
        "expo-sharing",
        {
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "*/*"
            ]
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "授权 Unoscil 使用相机以扫描二维码接入服务器",
          "microphonePermission": "授权 Unoscil 在录像时使用麦克风"
        }
      ],
      "expo-sqlite",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "zh-Hans",
              "en",
              "ru",
              "pt-BR"
            ],
            "android": [
              "zh",
              "en",
              "ru",
              "pt-BR"
            ]
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "share",
                  "bundleIdentifier": "app.unoscil.Unoscil.Share",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.app.unoscil.Unoscil",
                      "group.app.unoscil.ios"
                    ]
                  }
                },
                {
                  "targetName": "keyboard",
                  "bundleIdentifier": "app.unoscil.Unoscil.Keyboard",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.app.unoscil.Unoscil",
                      "group.app.unoscil.ios"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
